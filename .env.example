# Environment Variables for Crypto Trading Bot
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# Bybit Testnet API Credentials
# Get these from: https://testnet.bybit.com/user/api-management
BYBIT_TESTNET_API_KEY=your_api_key_here
BYBIT_TESTNET_API_SECRET=your_api_secret_here

# Telegram Bot (Optional - for notifications)
# Create bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Freqtrade API Server Credentials
# Generate JWT secret: python -c "import secrets; print(secrets.token_hex(32))"
API_JWT_SECRET=changeme_generate_with_command_above
API_USERNAME=freqtrader
API_PASSWORD=changeme_create_strong_password

# Risk Management Settings (Optional - override defaults)
MAX_DRAWDOWN=0.20
DAILY_LOSS_LIMIT=0.06
RISK_PER_TRADE=0.02

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
