{
  "_comment": "✅ SHARIA COMPLIANT CONFIG - Spot trading only, no leverage, long positions only",
  "_comment2": "Bybit Testnet: Uses virtual funds ($50,000 USDT) for demo trading",

  "trading_mode": "spot",
  "margin_mode": "",

  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.02,
  "fiat_display_currency": "USD",
  "dry_run": false,
  "cancel_open_orders_on_exit": true,

  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },

  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "exchange": {
    "name": "bybit",
    "key": "${BYBIT_TESTNET_API_KEY}",
    "secret": "${BYBIT_TESTNET_API_SECRET}",
    "ccxt_config": {
      "enableRateLimit": true,
      "urls": {
        "api": {
          "public": "https://api-testnet.bybit.com",
          "private": "https://api-testnet.bybit.com"
        }
      },
      "options": {
        "defaultType": "spot"
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 200
    },
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "ADA/USDT",
      "AVAX/USDT"
    ],
    "pair_blacklist": []
  },

  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],

  "edge": {
    "enabled": false
  },

  "telegram": {
    "enabled": false,
    "token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}",
    "notification_settings": {
      "status": "on",
      "warning": "on",
      "startup": "on",
      "entry": "on",
      "entry_fill": "on",
      "entry_cancel": "on",
      "exit": {
        "roi": "on",
        "emergency_exit": "on",
        "force_exit": "on",
        "exit_signal": "on",
        "trailing_stop_loss": "on",
        "stop_loss": "on",
        "stoploss_on_exchange": "on",
        "custom_exit": "on"
      },
      "exit_cancel": "on",
      "exit_fill": "on",
      "protection_trigger": "on",
      "protection_trigger_global": "on"
    },
    "reload": true,
    "balance_dust_level": 0.01
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "${API_JWT_SECRET}",
    "CORS_origins": [],
    "username": "${API_USERNAME}",
    "password": "${API_PASSWORD}"
  },

  "bot_name": "crypto-trading-bot-halal-testnet",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
